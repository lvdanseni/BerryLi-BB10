<Application x:Class="BiliClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BiliClient"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisible"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
