<UserControl x:Class="BiliClient.Views.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BiliClient.Views"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：返回 + 搜索框（对应 BBTube SearchPage 的 sticky search field） -->
        <Border Grid.Row="0" Padding="28,22,28,12" Background="{StaticResource BgBrush}">
            <StackPanel>
                <TextBlock Text="搜索" Style="{StaticResource PageTitleStyle}"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="搜索 B 站视频" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="14" VerticalAlignment="Center" Margin="14,0,0,0"
                               IsHitTestVisible="False" MouseDown="OnHintClick"/>
                    <Button Grid.Column="1" Content="搜索" Style="{StaticResource AccentButtonStyle}"
                            Margin="12,0,0,0" Click="OnSearchClick"/>
                </Grid>
                <StackPanel x:Name="HistoryChips" Orientation="Horizontal" Margin="0,12,0,0"
                            Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <views:FeedPage x:Name="Feed" Grid.Row="1" PageTitle="搜索结果" VideoRequested="OnVideoRequested"/>
    </Grid>
</UserControl>
