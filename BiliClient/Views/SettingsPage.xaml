<UserControl x:Class="BiliClient.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>

            <!-- 关于 -->
            <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Margin="0,18,0,0" Padding="18,16">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               Text="关于本客户端"/>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Text="BiliClient 是一个 Windows 原生（WPF/.NET 9）Bilibili 客户端，架构逆向自 BBTube 1.13.0.276（BlackBerry 10 非官方 YouTube 客户端）：原生 UI 负责展示与交互，C# API 客户端负责数据（WBI 签名），WebView2 播放引擎负责视频解码播放。"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"
                               Text="版本 1.0.0 · 数据来源：bilibili 公开 Web API · 未登录态 · 深色主题 主色 #FB7299"/>
                </StackPanel>
            </Border>

            <!-- 架构说明 -->
            <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Margin="0,14,0,0" Padding="18,16">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               Text="架构（映射 BBTube 分层）"/>
                    <ItemsControl Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock Text="{Binding Level}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                               FontSize="13" Width="120"/>
                                    <TextBlock Text="{Binding Desc}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13" TextWrapping="Wrap" MaxWidth="560"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Items>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock Text="UI 层" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="13" Width="120"/>
                                <TextBlock Text="WPF XAML 深色主题 + 卡片流（BBTube: Cascades QML TabbedPane + ListView）" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock Text="数据层" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="13" Width="120"/>
                                <TextBlock Text="BiliApi + WbiSigner 分页 Store（BBTube: InnerTube 客户端 + FeedStore）" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock Text="播放引擎" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="13" Width="120"/>
                                <TextBlock Text="WebView2 内嵌官方播放器（BBTube: WPE WebKit ytengine + libbbplayer）" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 网络自检 -->
            <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Margin="0,14,0,0" Padding="18,16">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               Text="网络自检"/>
                    <Button Content="测试 API 连通性" Style="{StaticResource PillButtonStyle}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Click="OnTestApi"/>
                    <TextBlock x:Name="TestResult" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- 数据声明 -->
            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap"
                       Text="本客户端仅供学习与研究（逆向学习 BBTube 技术结构后开发）。数据来自 bilibili 公开接口；播放器使用官方内嵌播放器。请遵守 bilibili 服务条款与相关法律法规。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
