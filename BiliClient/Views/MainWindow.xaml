<Window x:Class="BiliClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BiliClient · B 站原生客户端" Height="820" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏（对应 BBTube TabbedPane：品牌 + 标签 + 底部设置） -->
        <Border Grid.Column="0" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Margin="22,26,22,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="B" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="BiliClient" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="BBTube 架构移植" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- 导航按钮 -->
                <StackPanel x:Name="NavList" Grid.Row="1" Margin="10,0,10,0">
                    <TextBlock Text="内容" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="14,6,0,6"/>
                    <Button x:Name="NavHome" Content="  首页推荐" Style="{StaticResource NavButtonStyle}" Tag="home"
                            Click="OnNavClick" Foreground="{StaticResource NavActiveBrush}" FontWeight="SemiBold"/>
                    <Button x:Name="NavPopular" Content="  热门" Style="{StaticResource NavButtonStyle}" Tag="popular"
                            Click="OnNavClick"/>
                    <Button x:Name="NavRanking" Content="  排行榜" Style="{StaticResource NavButtonStyle}" Tag="ranking"
                            Click="OnNavClick"/>
                    <Button x:Name="NavRegion" Content="  分区" Style="{StaticResource NavButtonStyle}" Tag="region"
                            Click="OnNavClick"/>
                    <Button x:Name="NavSearch" Content="  搜索" Style="{StaticResource NavButtonStyle}" Tag="search"
                            Click="OnNavClick"/>
                    <TextBlock Text="其他" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="14,18,0,6"/>
                    <Button x:Name="NavSettings" Content="  设置" Style="{StaticResource NavButtonStyle}" Tag="settings"
                            Click="OnNavClick"/>
                </StackPanel>

                <!-- 底部状态 -->
                <StackPanel Grid.Row="2" Margin="22,0,22,20">
                    <TextBlock Text="未登录 · 匿名浏览" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="数据: api.bilibili.com" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区（对应 NavigationPane 页面栈） -->
        <Grid Grid.Column="1">
            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
