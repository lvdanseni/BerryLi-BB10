<UserControl x:Class="BiliClient.Views.RegionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BiliClient.Views">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 分区选择（对应 BBTube 的频道导航） -->
        <Border Grid.Row="0" Padding="28,22,28,12">
            <StackPanel>
                <TextBlock Text="分区" Style="{StaticResource PageTitleStyle}"/>
                <StackPanel x:Name="RegionChips" Orientation="Horizontal" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <views:FeedPage x:Name="Feed" Grid.Row="1" PageTitle="分区内容" VideoRequested="OnVideoRequested"/>
    </Grid>
</UserControl>
